# 데이터베이스 설정 (예시)
DB_HOST=localhost
DB_PORT=3306
DB_USER=rebalancer
DB_PASSWORD=your_password_here
DB_NAME=rebalance_db
DB_SOCKET=

# FastAPI 설정
DEBUG=False
LOG_LEVEL=INFO

# FCM 설정 (Phase 2)
FCM_API_KEY=your_fcm_api_key_here
FCM_PROJECT_ID=your_fcm_project_id_here

# 이메일 설정 (Phase 2)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com

# 텔레그램 설정 (선택사항)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# 공공데이터포털 - 특일 정보 API (휴장일 캘린더 자동 점검용, 선택사항)
# 발급: https://www.data.go.kr -> "특일 정보" 검색 -> 한국천문연구원_특일 정보 활용신청
HOLIDAY_API_KEY=your_holiday_api_key

# 외부 노출 주소 (텔레그램 알림의 "전체 상세" 링크에 사용)
BASE_URL=http://your_ddns_domain:8001
